generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OwnerStatusType {
  PET_OWNER
  BREEDER
  RESCUE
  FOSTER
  PROFESSIONAL
}

enum RoleApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  WITHDRAWN
}

enum RequestedRole {
  BREEDER
  RESCUE
  FOSTER
  PROFESSIONAL
}

enum ProfessionalCategory {
  TRAINER
  GROOMER
  DOG_WALKER
  BEHAVIOURIST
  PHOTOGRAPHER
  VETERINARY_CARE
  OTHER
}

enum PromotionTier {
  NONE
  FEATURED
}

enum DogVisibility {
  PUBLIC
  PRIVATE
  LINK_ONLY
}

enum DogAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

enum DogRelationshipType {
  CO_OWNER
  KEEPER
  CONTRACT_HOLDER
  FOSTER
  RESCUE
  BREEDER
  VETERINARY
  GROOMER
  TRAINER
  SITTER
  OTHER_PROFESSIONAL
}

enum DogAccessLevel {
  VIEW
  CONTRIBUTE
  MANAGE
}

enum DogRecordCategory {
  IDENTITY
  DNA
  HEALTH
  CARE
  IDENTIFICATION
  INSURANCE
  PEDIGREE
  TITLES
  WORKING_QUALIFICATIONS
  ACTIVITIES_WORK
  TEMPERAMENT_TESTS
  BREEDING_APPROVALS
  OTHER
}

enum DogRecordStatus {
  HAVE_RECORD
  DO_NOT_HAVE
}

enum DogRecordVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum BehaviourAnswer {
  YES
  NO
  UNKNOWN
}

enum BehaviourAssessmentSource {
  OWNER_DECLARED
  VERIFIED_RESCUE_ASSESSED
}

enum UserRole {
  MEMBER
  ADMIN
}

enum CompetitionStatus {
  DRAFT
  PUBLISHED
  OPEN
  CLOSED
  JUDGING
  COMPLETED
  CANCELLED
}

enum CompetitionEligibility {
  UK_ONLY
  INTERNATIONAL
}

enum CompetitionEntryStatus {
  SUBMITTED
  WITHDRAWN
  DISQUALIFIED
  FINALIST
  WINNER
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  passwordHash             String
  displayName              String
  username                 String                  @unique
  country                  String
  over16                   Boolean
  ownerStatuses            OwnerStatus[]
  roleApplications         RoleApplication[]
  reviewedRoleApplications RoleApplication[]       @relation("RoleApplicationReviewer")
  dogOwnerships            DogOwnership[]
  requestedDogAccess       DogAccessRequest[]      @relation("DogAccessRequester")
  incomingDogAccess        DogAccessRequest[]      @relation("DogAccessTargetOwner")
  reviewedDogAccess        DogAccessRequest[]      @relation("DogAccessReviewer")
  revokedDogAccess         DogAccessRequest[]      @relation("DogAccessRevoker")
  uploadedDogPhotos        DogProfilePhoto[]
  uploadedRecordDocuments  DogRecordDocument[]
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  role                     UserRole                @default(MEMBER)
  evidenceLinks            DogRecordEvidenceLink[]
  competitionEntries       CompetitionEntry[]
  cancelledCompetitions    Competition[]           @relation("CompetitionCanceller")
  newsPosts                NewsPost[]
  events                   Event[]
  professionalProfiles     ProfessionalProfile[]
  professionalEvidenceReviewed ProfessionalProfileEvidence[] @relation("ProfessionalEvidenceReviewer")
  professionalProfilesReviewed ProfessionalProfile[] @relation("ProfessionalProfileReviewer")
}

model OwnerStatus {
  id        String          @id @default(cuid())
  userId    String
  status    OwnerStatusType
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, status])
}

model RoleApplication {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRole        RequestedRole
  status               RoleApplicationStatus @default(DRAFT)
  applicantType        String?
  organisationName     String?
  publicDisplayName    String?
  website              String?
  email                String?
  showEmailPublicly    Boolean               @default(false)
  phone                String?
  serviceArea          String?
  registrationNumber   String?
  charityNumber        String?
  insuranceDetails     String?
  qualifications       String?
  professionalCategory ProfessionalCategory?
  breeds               String?
  description          String?
  evidenceNotes        String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?                 @relation("RoleApplicationReviewer", fields: [reviewedById], references: [id])
  rejectionReason      String?
  isFeatured           Boolean               @default(false)
  featuredUntil        DateTime?
  promotionTier        PromotionTier         @default(NONE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId])
  @@index([requestedRole])
  @@index([status])
  @@index([organisationName])
  @@index([requestedRole, status])
}

model DogIdentity {
  id                    String                 @id @default(cuid())
  registryNumber        String                 @unique
  registrySequence      Int                    @unique @default(autoincrement())
  name                  String
  primaryRole           String
  kennelClubName        String?
  breed                 String?
  isMixedBreed          Boolean                @default(false)
  breedMix              String?
  dnaConfirmed          String?
  dogTypes              String?
  neuteredSpayed        String?
  dateOfBirth           DateTime?
  estimatedDob          Boolean                @default(false)
  sex                   String?
  colour                String?
  microchipNumber       String?
  vaccinated            BehaviourAnswer        @default(UNKNOWN)
  lastVaccinationDate   DateTime?
  countryOfRegistration String?
  visibility            DogVisibility          @default(PUBLIC)
  ownerships            DogOwnership[]
  accessRequests        DogAccessRequest[]
  records               DogRecord[]
  profilePhoto          DogProfilePhoto?
  behaviourLifestyle    DogBehaviourLifestyle?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  competitionEntries    CompetitionEntry[]
  nickname              String?
  heritageParents       DogHeritageParent[]
  vaccinations          DogVaccination[]
}

enum HeritageParentType {
  MOTHER
  FATHER
}

enum RegistryAffiliation {
  YES
  NO
  UNKNOWN
}

model DogHeritageParent {
  id                      String              @id @default(cuid())
  dogId                   String
  dog                     DogIdentity         @relation(fields: [dogId], references: [id], onDelete: Cascade)
  parentType              HeritageParentType
  isUnknown               Boolean             @default(false)
  parentName              String?
  barkBoothRegistryNumber String?
  breed                   String?
  colourMarkings          String?
  registryAffiliated      RegistryAffiliation @default(UNKNOWN)
  registryName            String?
  registryNumber          String?
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([dogId, parentType])
  @@index([barkBoothRegistryNumber])
}

model DogVaccination {
  id                 String      @id @default(cuid())
  dogId              String
  dog                DogIdentity @relation(fields: [dogId], references: [id], onDelete: Cascade)
  name               String      @db.VarChar(160)
  vaccinated         Boolean     @default(false)
  administeredAt     DateTime?
  nextDueAt          DateTime?
  veterinaryPractice String?     @db.VarChar(200)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([dogId, nextDueAt])
}

model DogBehaviourLifestyle {
  id                    String                    @id @default(cuid())
  dogId                 String                    @unique
  dog                   DogIdentity               @relation(fields: [dogId], references: [id], onDelete: Cascade)
  assessmentSource      BehaviourAssessmentSource @default(OWNER_DECLARED)
  reactive              BehaviourAnswer           @default(UNKNOWN)
  foodAggression        BehaviourAnswer           @default(UNKNOWN)
  resourceGuarding      BehaviourAnswer           @default(UNKNOWN)
  separationAnxiety     BehaviourAnswer           @default(UNKNOWN)
  highPreyDrive         BehaviourAnswer           @default(UNKNOWN)
  escapeArtist          BehaviourAnswer           @default(UNKNOWN)
  goodWithChildren      BehaviourAnswer           @default(UNKNOWN)
  goodWithDogs          BehaviourAnswer           @default(UNKNOWN)
  goodWithCats          BehaviourAnswer           @default(UNKNOWN)
  goodWithLivestock     BehaviourAnswer           @default(UNKNOWN)
  friendlyWithStrangers BehaviourAnswer           @default(UNKNOWN)
  reliableOffLead       BehaviourAnswer           @default(UNKNOWN)
  recallTrained         BehaviourAnswer           @default(UNKNOWN)
  crateTrained          BehaviourAnswer           @default(UNKNOWN)
  muzzleTrained         BehaviourAnswer           @default(UNKNOWN)
  neuteredSpayed        BehaviourAnswer           @default(UNKNOWN)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([assessmentSource])
}

model DogRecord {
  id                 String                      @id @default(cuid())
  dogId              String
  dog                DogIdentity                 @relation(fields: [dogId], references: [id], onDelete: Cascade)
  category           DogRecordCategory
  recordType         String
  provider           String?
  status             DogRecordStatus             @default(HAVE_RECORD)
  verificationStatus DogRecordVerificationStatus @default(NOT_SUBMITTED)
  referenceNumber    String?
  issueDate          DateTime?
  expiryDate         DateTime?
  notes              String?
  systemGenerated    Boolean                     @default(false)
  normalizedRecordType String?
  documents          DogRecordDocument[]
  evidenceLinks      DogRecordEvidenceLink[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([dogId, category])
  @@index([dogId, verificationStatus])
  @@index([category, recordType])
  @@index([provider])
  @@index([dogId, category, normalizedRecordType, systemGenerated])
}

model DogRecordEvidenceLink {
  id              String    @id @default(cuid())
  recordId        String
  record          DogRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  addedById       String
  addedBy         User      @relation(fields: [addedById], references: [id], onDelete: Restrict)
  providerLabel   String    @db.VarChar(120)
  url             String    @db.VarChar(2048)
  referenceNumber String?   @db.VarChar(160)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([recordId])
  @@index([addedById])
}

model Competition {
  id                 String                 @id @default(cuid())
  slug               String                 @unique @db.VarChar(120)
  title              String                 @db.VarChar(160)
  theme              String                 @db.VarChar(160)
  description        String
  status             CompetitionStatus      @default(DRAFT)
  opensAt            DateTime
  closesAt           DateTime
  resultPublishedAt  DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?                  @relation("CompetitionCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancellationReason String?                @db.VarChar(500)
  eligibility        CompetitionEligibility @default(UK_ONLY)
  entryFeePence      Int                    @default(0)
  maxEntriesPerDog   Int                    @default(1)
  prizeSummary       String
  rules              String
  rulesVersion       String                 @default("1") @db.VarChar(40)
  imageGuidelines    String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  entries            CompetitionEntry[]
  results            CompetitionResult[]
  heroStorageKey     String?                @unique
  heroFileName       String?
  heroContentType    String?
  heroSizeBytes      Int?
  judges             CompetitionJudge[]
  newsPosts          NewsPost[]

  @@index([status, opensAt, closesAt])
  @@index([cancelledById])
}

model CompetitionJudge {
  id               String      @id @default(cuid())
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name             String      @db.VarChar(160)
  roleTitle        String?     @db.VarChar(160)
  organisation     String?     @db.VarChar(200)
  biography        String?
  profession       String?
  judgingFocus     String?
  guestJudge       Boolean     @default(false)
  displayOrder     Int         @default(0)
  imageStorageKey  String?     @unique
  imageFileName    String?
  imageContentType String?
  imageSizeBytes   Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([competitionId, displayOrder])
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


enum ProfessionalProfileType {
  VET
  GROOMER
  TRAINER
  BEHAVIOURIST
  DOG_WALKER
  PET_SITTER
  DAY_CARE
  BOARDING_KENNELS
  HYDROTHERAPY
  PHYSIOTHERAPIST
  BREEDER
  RESCUE
  PHOTOGRAPHER
  OTHER
}

enum ProfessionalProfilePublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProfessionalProfileVerificationStatus {
  NOT_SUBMITTED
  EVIDENCE_SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ProfessionalAddressVisibility {
  FULL_ADDRESS
  TOWN_AREA_ONLY
  SERVICE_AREA_ONLY
}

enum ServiceRadiusUnit {
  MILES
  KILOMETRES
}

enum ProfessionalEvidenceType {
  QUALIFICATION
  INSURANCE
  LICENCE
  MEMBERSHIP
  FIRST_AID
  OTHER
}

enum ProfessionalMediaKind {
  LOGO
  GALLERY
}

model ProfessionalProfile {
  id                 String                                  @id @default(cuid())
  ownerUserId        String
  owner              User                                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  type               ProfessionalProfileType
  customType         String?                                 @db.VarChar(80)
  businessName       String                                  @db.VarChar(160)
  slug               String                                  @unique @db.VarChar(180)
  shortDescription   String                                  @db.VarChar(600)
  yearEstablished    Int?
  email              String?                                 @db.VarChar(254)
  phone              String?                                 @db.VarChar(60)
  website            String?                                 @db.VarChar(2048)
  facebookUrl        String?                                 @db.VarChar(2048)
  instagramUrl       String?                                 @db.VarChar(2048)
  addressLine1       String?                                 @db.VarChar(200)
  addressLine2       String?                                 @db.VarChar(200)
  townCity           String?                                 @db.VarChar(120)
  regionCounty       String?                                 @db.VarChar(120)
  postcode           String?                                 @db.VarChar(40)
  country            String                                  @db.VarChar(120)
  mobileBusiness     Boolean                                 @default(false)
  serviceRadiusValue Int?
  serviceRadiusUnit  ServiceRadiusUnit                       @default(MILES)
  addressVisibility  ProfessionalAddressVisibility           @default(TOWN_AREA_ONLY)
  publicationStatus  ProfessionalProfilePublicationStatus    @default(DRAFT)
  verificationStatus ProfessionalProfileVerificationStatus   @default(NOT_SUBMITTED)
  verificationNotes  String?
  adminReviewNotes   String?
  reviewedById       String?
  reviewedBy         User?                                   @relation("ProfessionalProfileReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?
  publishedAt        DateTime?
  archivedAt         DateTime?
  archiveReason      String?                                 @db.VarChar(500)
  hoursNote          String?
  appointmentOnly    Boolean                                 @default(false)
  services           ProfessionalProfileService[]
  evidence           ProfessionalProfileEvidence[]
  media              ProfessionalProfileMedia[]
  openingHours       ProfessionalOpeningHour[]
  audits             ProfessionalProfileAudit[]
  createdAt          DateTime                                @default(now())
  updatedAt          DateTime                                @updatedAt

  @@index([ownerUserId])
  @@index([publicationStatus, type])
  @@index([verificationStatus])
}

model ProfessionalProfileService {
  id        String              @id @default(cuid())
  profileId String
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  serviceKey String             @db.VarChar(100)
  label     String              @db.VarChar(160)
  isOther   Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@unique([profileId, serviceKey])
}

model ProfessionalProfileEvidence {
  id                 String                                @id @default(cuid())
  profileId          String
  profile            ProfessionalProfile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  evidenceType       ProfessionalEvidenceType
  title              String                                @db.VarChar(160)
  issuerProvider     String?                               @db.VarChar(160)
  referenceNumber    String?                               @db.VarChar(160)
  expiryDate         DateTime?
  storageKey         String?                               @unique
  fileName           String?
  contentType        String?
  sizeBytes          Int?
  publicUrl          String?                               @db.VarChar(2048)
  publicUrlVisible   Boolean                               @default(false)
  ownerNotes         String?
  verificationStatus ProfessionalProfileVerificationStatus @default(NOT_SUBMITTED)
  adminReviewNotes   String?
  reviewedById       String?
  reviewedBy         User?                                 @relation("ProfessionalEvidenceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt

  @@index([profileId])
  @@index([verificationStatus])
}

model ProfessionalProfileMedia {
  id          String                  @id @default(cuid())
  profileId   String
  profile     ProfessionalProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind        ProfessionalMediaKind
  storageKey  String                  @unique
  fileName    String
  contentType String
  sizeBytes   Int
  displayOrder Int                    @default(0)
  altText     String?                 @db.VarChar(240)
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([profileId, kind, active, displayOrder])
}

model ProfessionalOpeningHour {
  id           String              @id @default(cuid())
  profileId    String
  profile      ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  closed       Boolean             @default(false)
  opensAt      String?             @db.VarChar(5)
  closesAt     String?             @db.VarChar(5)
  secondOpensAt String?            @db.VarChar(5)
  secondClosesAt String?           @db.VarChar(5)

  @@unique([profileId, dayOfWeek])
}

model ProfessionalProfileAudit {
  id        String              @id @default(cuid())
  profileId String
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actorUserId String?
  action    String              @db.VarChar(80)
  reason    String?             @db.VarChar(500)
  createdAt DateTime            @default(now())

  @@index([profileId, createdAt])
}

model NewsPost {
  id               String            @id @default(cuid())
  authorId         String
  author           User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  competitionId    String?
  competition      Competition?      @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  slug             String            @unique @db.VarChar(160)
  title            String            @db.VarChar(200)
  summary          String?
  body             String
  status           PublicationStatus @default(DRAFT)
  featured         Boolean           @default(false)
  publishedAt      DateTime?
  imageStorageKey  String?           @unique
  imageFileName    String?
  imageContentType String?
  imageSizeBytes   Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, publishedAt])
}

model Event {
  id          String            @id @default(cuid())
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  name        String            @db.VarChar(200)
  description String
  location    String?           @db.VarChar(240)
  startsAt    DateTime
  endsAt      DateTime?
  externalUrl String?           @db.VarChar(2048)
  organiser   String?           @db.VarChar(200)
  status      PublicationStatus @default(DRAFT)
  cancelled   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, startsAt])
}

model CompetitionEntry {
  id                  String                 @id @default(cuid())
  competitionId       String
  competition         Competition            @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  dogId               String
  dog                 DogIdentity            @relation(fields: [dogId], references: [id], onDelete: Restrict)
  submittedById       String
  submittedBy         User                   @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  caption             String?                @db.VarChar(300)
  storageKey          String                 @unique
  fileName            String
  contentType         String
  sizeBytes           Int
  status              CompetitionEntryStatus @default(SUBMITTED)
  profileCompleteness Int
  rulesVersion        String                 @db.VarChar(40)
  rulesAcceptedAt     DateTime
  imageUseConsentAt   DateTime
  moderationReason    String?                @db.VarChar(500)
  submittedAt         DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  results             CompetitionResult[]

  @@index([competitionId, status])
  @@index([dogId])
  @@index([submittedById])
}

model CompetitionResult {
  id            String           @id @default(cuid())
  competitionId String
  competition   Competition      @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  entryId       String
  entry         CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  placement     Int
  title         String           @db.VarChar(160)
  judgeNotes    String?
  publishedAt   DateTime?

  @@unique([competitionId, placement])
  @@unique([competitionId, entryId])
}

model DogProfilePhoto {
  id           String      @id @default(cuid())
  dogId        String      @unique
  dog          DogIdentity @relation(fields: [dogId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  storageKey   String      @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([uploadedById])
}

model DogRecordDocument {
  id           String    @id @default(cuid())
  recordId     String
  record       DogRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  storageKey   String    @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime  @default(now())

  @@index([recordId])
  @@index([uploadedById])
}

model DogOwnership {
  id        String      @id @default(cuid())
  userId    String
  dogId     String
  role      String      @default("OWNER")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dog       DogIdentity @relation(fields: [dogId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, dogId])
}

model DogAccessRequest {
  id                    String                 @id @default(cuid())
  dogId                 String
  dog                   DogIdentity            @relation(fields: [dogId], references: [id], onDelete: Cascade)
  requesterUserId       String
  requester             User                   @relation("DogAccessRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  targetOwnerUserId     String
  targetOwner           User                   @relation("DogAccessTargetOwner", fields: [targetOwnerUserId], references: [id], onDelete: Cascade)
  requestedRelationship DogRelationshipType
  requestedAccessLevel  DogAccessLevel         @default(VIEW)
  status                DogAccessRequestStatus @default(PENDING)
  message               String?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewedBy            User?                  @relation("DogAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  revokedAt             DateTime?
  revokedById           String?
  revokedBy             User?                  @relation("DogAccessRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([dogId, status])
  @@index([requesterUserId, status])
  @@index([targetOwnerUserId, status])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}
